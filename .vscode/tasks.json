{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Front-end",
            "type": "shell",
            "command": "npm run dev",
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "group": "none",
            "presentation": {
                "group": "nexus-projets"
            }
        },
        {
            "label": "Start Back-end",
            "type": "shell",
            "command": "npm run dev",
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "group": "none",
            "presentation": {
                "group": "nexus-projets"
            }
        },
        {
            "label": "Start All (Front + Back)",
            "dependsOn": [
                "Start Front-end",
                "Start Back-end"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
